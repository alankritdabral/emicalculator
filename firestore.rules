rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user has an admin record
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Access Codes collection (100% Free Plan Security Model)
    // - allow get: Allows looking up an EXACT code entered by the user.
    // - allow list: FORBIDDEN! Nobody can list, query, or download the secret codes.
    // - allow write: Only authenticated admins can create or delete codes.
    match /access_codes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Settings collection (Stores active code metadata for the Admin Dashboard)
    // Only admins can view or change this document.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Admins collection
    // Admins can read their own profile to verify their role
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }
  }
}
